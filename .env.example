# Connexion PostgreSQL. Obligatoire : l'application refuse de démarrer sans.
#
# Sur Netlify, utilisez la chaîne « Connection pooling » de votre projet
# Supabase (port 6543), et non la connexion directe (port 5432) : les fonctions
# serverless ouvrent une connexion par instance et épuiseraient le quota.
#
# Exemple :
# DATABASE_URL=postgresql://postgres.abcdefgh:motdepasse@aws-0-eu-west-3.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://user:password@localhost:5432/app_db

# Mot de passe unique de l'espace /admin. Obligatoire en production.
ADMIN_PASSWORD=changez-moi

# Clé de signature des cookies de session. Obligatoire en production : sans
# elle, les sessions sont signées avec une clé dérivée du mot de passe.
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
