# Sur Netlify, cette variable est inutile : la base de la plateforme est
# annoncée par NETLIFY_DB_URL, que Netlify injecte elle-même (builds, fonctions
# et `netlify dev`). Elle n'est à renseigner que si vous utilisez VOTRE propre
# PostgreSQL : une base locale en développement, ou un service externe.
#
# Sur Supabase, prenez la chaîne « Connection pooling » (port 6543) plutôt que
# la connexion directe (port 5432) : les fonctions serverless ouvrent une
# connexion par instance et épuiseraient le quota.
DATABASE_URL=postgresql://user:password@localhost:5432/app_db

# Mot de passe unique de l'espace /admin. Obligatoire en production : sur
# Netlify, c'est la seule variable à déclarer.
ADMIN_PASSWORD=changez-moi

# Clé de signature des cookies de session. Recommandée : sans elle, les
# sessions sont signées avec une clé dérivée du mot de passe.
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
