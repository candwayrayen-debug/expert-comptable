# Connexion PostgreSQL. Obligatoire : l'application refuse de démarrer sans.
DATABASE_URL=postgresql://user:password@localhost:5432/app_db

# Mot de passe unique de l'espace /admin. Obligatoire en production.
ADMIN_PASSWORD=changez-moi

# Clé de signature des cookies de session. Obligatoire en production.
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
